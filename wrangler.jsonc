{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "prism-gram",
    "main": "src/index.ts",
    "compatibility_date": "2026-05-20",
    "compatibility_flags": ["nodejs_compat"],
    "upload_source_maps": true,
    "workers_dev": false,
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
        },
        "traces": {
            "enabled": true,
        },
    },
    "send_email": [
        {
            "name": "EMAIL",
            "remote": true,
        },
    ],
}
