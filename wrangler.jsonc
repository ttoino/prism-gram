{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "prism-gram",
    "main": "src/index.ts",
    "compatibility_date": "2026-05-20",
    "compatibility_flags": ["nodejs_compat"],
    "upload_source_maps": true,
    "workers_dev": false,
    "preview_urls": false,
    "limits": {
        "cpu_ms": 300000,
    },
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
        },
        "traces": {
            "enabled": true,
        },
    },
    "send_email": [
        {
            "name": "EMAIL",
            "remote": true,
        },
    ],
    "vars": {
        "ACCOUNT_ID": "e024e5a1e487a3d3a07815b431986107",
        "FORWARDING_DOMAIN": "toino.pt",
        "SENDING_DOMAIN": "send.toino.pt",
        "ZONE_ID": "176e8d0662f9d794ad70131efd5ebb32",
    },
    "secrets": {
        "required": ["CLOUDFLARE_API_TOKEN", "SENDING_PASSWORD"],
    },
}
